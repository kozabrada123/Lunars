# Example .env file, tweak to your tastes

# Json file with our authorization keys
# Users.json is an example file that should be unversioned to not leak sensitive information
# It's hashed, it has to be, but still
KEYFILE="users.json"

# Log directory
LOGDIR="/home/code/Lunars/logs"

# Include this is you will be running behind a reverse proxy;
#
# Configures the server to rely on X-Real-IP as the canonical
# source of the requester's IP, to perform rate-limiting.
#
# Incorrectly configuring this can be detrimental to security
#
#USE_REVERSE_PROXY="true"
USE_REVERSE_PROXY="false"

# Backup directory
BACKUPDIR="/home/code/Lunars/backups"
